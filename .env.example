# Copy this file to .env and fill in your local PostgreSQL credentials
PGHOST=localhost
PGPORT=5432
PGDATABASE=KumarExports
PGUSER=postgres
PGPASSWORD=your_postgres_password

# Server port
PORT=4000

# JWT secret for signing auth tokens (set a strong random value in production)
JWT_SECRET=your_jwt_secret_here

# Comma-separated frontend origin(s), for example https://hr.example.com
CORS_ORIGIN=http://localhost:5173
